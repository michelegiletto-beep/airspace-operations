# Copy to a private environment file. Do not commit real values.
AIRSPACE_RUNTIME=runtime
# SQLite portability is default; container profile uses PostgreSQL.
# POSTGRES_PASSWORD=<private database bootstrap administrator password>
# AIRSPACE_DB_APP_PASSWORD=<different private ordinary application password>
# AIRSPACE_DATABASE_URL=postgresql+psycopg://airspace:REPLACE@database:5432/airspace
# AIRSPACE_AUDIT_KEY=<at least 32 random bytes represented as a private string>
AIRSPACE_REQUIRE_TWO_REVIEWERS=true
# OIDC is optional; local identity works without a provider.
# AIRSPACE_OIDC_ISSUER=https://your-provider.example
# AIRSPACE_OIDC_JWKS_URL=https://your-provider.example/.well-known/jwks.json
# AIRSPACE_OIDC_AUDIENCE=your-application
# AIRSPACE_OIDC_SUBJECTS={"verified-issuer-subject":"existing-user-id"}
