  "harness_source": "\"\"\"Isolated browser fault injection; no operational records or model calls.\"\"\"\nimport json\nimport secrets\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT / \"backend\"))\nfrom airspace.api import create_app\nfrom airspace.identity import provision\nfrom airspace.storage import Store, users\nfrom sqlalchemy import select\nfrom fastapi.responses import PlainTextResponse\nimport uvicorn\n\nHERE = Path(__file__).resolve().parent / \"companion-fallback-browser\"\nHERE.mkdir(exist_ok=True)\nkey_path = HERE / \"audit.key\"\nif not key_path.exists():\n    key_path.write_bytes(secrets.token_bytes(48))\nstore = Store(\"sqlite:///\" + (HERE / \"isolated-test.db\").as_posix(), key_path.read_bytes())\nstore.migrate()\ncredentials_path = HERE / \"credentials.json\"\ncredentials = json.loads(credentials_path.read_text()) if credentials_path.exists() else {\"email\": \"fallback@test.invalid\", \"password\": secrets.token_urlsafe(24)}\nwith store.engine.connect() as conn:\n    exists = conn.execute(select(users.c.id).where(users.c.email == credentials[\"email\"])).first()\nif not exists:\n    provision(store, \"Isolated animation browser software test\", credentials[\"email\"], \"viewer\", credentials[\"password\"])\ncredentials_path.write_text(json.dumps(credentials), encoding=\"utf-8\")\napp = create_app(store)\n\n@app.middleware(\"http\")\nasync def unavailable_renderer(request, call_next):\n    if request.url.path == \"/vendor/systemlab-companion/mascot-renderer.mjs\":\n        return PlainTextResponse(\"Isolated renderer-unavailability test\", status_code=503)\n    return await call_next(request)\n\nuvicorn.run(app, host=\"127.0.0.1\", port=8791, access_log=False)\n",
